{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "containerEnv": {
    "GDAL_VERSION": "3.3.2"
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y gdal-bin libgdal-dev libgeos-dev && pip3 install --user --no-cache-dir -r requirements.txt || echo '⚠️ Failed to install requirements!'",
  "postCreateCommand": "pip3 install --user --no-cache-dir -r requirements.txt",
  "postAttachCommand": {
     "server": "/bin/sh -c 'mkdir -p ~/.streamlit && cp /workspaces/Wander_Builders-1/.streamlit/config.toml ~/.streamlit/config.toml && streamlit run app.py'"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}